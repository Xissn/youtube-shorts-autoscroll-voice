@echo off
chcp 65001 >nul
title Загрузка расширения на GitHub
cls
echo ========================================================
echo   Загрузка расширения YouTube Shorts на GitHub
echo   Аккаунт: Xissn
echo ========================================================
echo.
echo Отправляем файлы в репозиторий...
echo (Если откроется окно браузера - просто нажмите кнопку Authorize / Войти)
echo.

git push -u origin main

if %errorlevel% equ 0 (
    echo.
    echo ========================================================
    echo   [УСПЕХ] Все файлы успешно выложены на GitHub!
    echo   Ссылка: https://github.com/Xissn/youtube-shorts-autoscroll-voice
    echo ========================================================
) else (
    echo.
    echo ========================================================
    echo   [ОШИБКА] Не удалось отправить. Проверьте, создали ли
    echo   вы репозиторий с именем: youtube-shorts-autoscroll-voice
    echo ========================================================
)

echo.
pause
