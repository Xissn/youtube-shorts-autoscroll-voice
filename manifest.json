{
  "manifest_version": 3,
  "name": "YouTube Shorts: Автопрокрутка и Голосовое управление",
  "short_name": "Shorts Auto & Voice",
  "version": "1.0.1",
  "description": "Автоматически листает Shorts после окончания видео. Голосовые команды: 'далее', 'пропустить', 'назад', 'пауза' и др.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Shorts Автопрокрутка и Голосовое управление"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
